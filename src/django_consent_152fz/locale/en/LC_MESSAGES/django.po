#: .\src\django_consent_152fz\admin.py:81
#: .\src\django_consent_152fz\admin.py:385
msgid "Тема"
msgstr "Subject"

#: .\src\django_consent_152fz\admin.py:87
msgid "Без шаблона"
msgstr "No template"

#: .\src\django_consent_152fz\admin.py:260
msgid "Audience groups"
msgstr "Audience groups"

#: .\src\django_consent_152fz\admin.py:262
msgid "Ограничьте публикацию выбранных редакций участниками указанных групп."
msgstr "Restrict publication of selected editorials to members of specified groups."

#: .\src\django_consent_152fz\admin.py:270
msgid "Коробочная цель (стартовый набор 152-ФЗ)"
msgstr "Boxed target (starter set 152-FZ)"

#: .\src\django_consent_152fz\admin.py:273
msgid ""
"Выберите цель из стартового набора 152-ФЗ, чтобы автоматически подставить "
"готовые значения кода, названия, описания и конфигурации полей. После "
"подстановки все значения можно отредактировать под проект."
msgstr "Select a target from the 152-FZ starter kit to automatically substitute ready-made code values, names, descriptions and field configurations. After substitution, all values ​​can be edited for the project."

#: .\src\django_consent_152fz\admin.py:314
#: .\src\django_consent_152fz\admin.py:412
#: .\src\django_consent_152fz\admin.py:557
msgid "Код"
msgstr "Code"

#: .\src\django_consent_152fz\admin.py:315
#: .\src\django_consent_152fz\admin.py:413
#: .\src\django_consent_152fz\admin.py:558
msgid "Название"
msgstr "Name"

#: .\src\django_consent_152fz\admin.py:316
#: .\src\django_consent_152fz\admin.py:415
#: .\src\django_consent_152fz\admin.py:559
#: .\src\django_consent_152fz\admin.py:1643
msgid "Описание"
msgstr "Description"

#: .\src\django_consent_152fz\admin.py:317
msgid "Конфигурация полей"
msgstr "Field configuration"

#: .\src\django_consent_152fz\admin.py:318
msgid "Стратегия отзыва"
msgstr "Recall strategy"

#: .\src\django_consent_152fz\admin.py:319
msgid "Режим повторного согласия"
msgstr "Re-consent mode"

#: .\src\django_consent_152fz\admin.py:320
msgid "Политика частоты подписания"
msgstr "Signing Frequency Policy"

#: .\src\django_consent_152fz\admin.py:321
msgid "Доступность для субъектов"
msgstr "Availability for subjects"

#: .\src\django_consent_152fz\admin.py:322
#| msgid "Вариант интерфейса согласия"
msgid "UI подтверждения для этой формы"
msgstr "Confirmation UI for this form"

#: .\src\django_consent_152fz\admin.py:323
#| msgid "Учитывать режим повторного согласия"
msgid "Обязательный checkbox (override)"
msgstr "Mandatory checkbox (override)"

#: .\src\django_consent_152fz\admin.py:324
#| msgid "Текст уведомления о повторном согласии"
msgid "Действие при «не согласен» (override)"
msgstr "Action when “I do not agree” (override)"

#: .\src\django_consent_152fz\admin.py:325
#| msgid "Подписывать при каждом действии"
msgid "Показывать предупреждение (override)"
msgstr "Show warning (override)"

#: .\src\django_consent_152fz\admin.py:326
#| msgid "Текст уведомления о повторном согласии"
msgid "Текст предупреждения (override)"
msgstr "Warning text (override)"

#: .\src\django_consent_152fz\admin.py:327
msgid "Экспериментальный режим"
msgstr "Experimental mode"

#: .\src\django_consent_152fz\admin.py:328
#: .\src\django_consent_152fz\admin.py:568
#: .\src\django_consent_152fz\verified_consents\admin.py:210
#: .\src\django_consent_152fz\verified_consents\admin.py:310
msgid "Активна"
msgstr "Active"

#: .\src\django_consent_152fz\admin.py:332
msgid ""
"Стабильный уникальный код цели (например: `newsletter_signup`, "
"`job_application`, `support_request`). Используется не только в API, но и во "
"внутренних связях, шаблонах, политиках доступа и маршрутизации логики "
"согласий."
msgstr "Stable unique target code (for example: __M0__, __M1__, __M2__). Used not only in the API, but also in internal communications, templates, access policies and routing of consent logic."

#: .\src\django_consent_152fz\admin.py:337
msgid "Краткое название цели, видимое в админке и UI-сценариях."
msgstr "The short name of the goal, visible in the admin panel and UI scripts."

#: .\src\django_consent_152fz\admin.py:338
msgid "Подробно опишите, для чего собирается и используется согласие."
msgstr "Describe in detail why consent is collected and used."

#: .\src\django_consent_152fz\admin.py:340
msgid ""
"JSON-конфигурация полей формы согласия. Минимальная структура: [{\"name\": "
"\"email\", \"required\": true}]. Каждый элемент — объект поля как минимум с "
"ключом `name`; рекомендуется указывать `required`."
msgstr "JSON configuration of consent form fields. Minimum structure: [{\"name\": \"email\", \"required\": true}]. Each element is a field object with at least a key __M0__; It is recommended to specify __M1__."

#: .\src\django_consent_152fz\admin.py:345
msgid "Поведение системы при отзыве согласия пользователем."
msgstr "System behavior when the user withdraws consent."

#: .\src\django_consent_152fz\admin.py:346
msgid "Когда и при каких условиях повторно запрашивать согласие."
msgstr "When and under what conditions to re-seek consent."

#: .\src\django_consent_152fz\admin.py:348
msgid ""
"Определяет, требовать ли подтверждение один раз до новой редакции или при "
"каждом пользовательском действии."
"Определяет, требовать ли подтверждение один раз до новой редакции или при "
"каждом пользовательском действии."
msgstr "Determines whether to require confirmation once before a new revision or at each user action."

#: .\src\django_consent_152fz\admin.py:352
msgid ""
"Ограничивает, может ли цель применяться только к авторизованным или также к "
"анонимным субъектам."
"Ограничивает, может ли цель применяться только к авторизованным или также к "
"анонимным субъектам."
msgstr "Limits whether the target can only apply to authorized or also anonymous entities."

#: .\src\django_consent_152fz\admin.py:356
msgid ""
"Тонкая настройка конкретной формы: наследовать глобальный режим, checkbox "
"или radio «согласен/не согласен»."
msgstr "Fine-tuning a specific form: inherit the global mode, checkbox or radio “agree/disagree”."

#: .\src\django_consent_152fz\admin.py:360
msgid ""
"Пусто = наследовать глобальную настройку. True/False = принудительное "
"поведение для этой формы."
msgstr "Empty = inherit global setting. True/False = Force behavior for this form."

#: .\src\django_consent_152fz\admin.py:364
msgid ""
"Как обрабатывать выбор «не согласен» для этой формы: наследовать, "
"блокировать отправку или разрешать отправку."
msgstr "How to handle \"disagree\" selection for this form: inherit, block submission, or allow submission."

#: .\src\django_consent_152fz\admin.py:368
msgid "Пусто = наследовать глобальную настройку показа предупреждения."
msgstr "Empty = Inherit the global warning display setting."

#: .\src\django_consent_152fz\admin.py:371
msgid ""
"Если заполнено, заменяет глобальный текст предупреждения для этой формы."
msgstr "If populated, replaces the global warning text for this form."

#: .\src\django_consent_152fz\admin.py:373
msgid "Включайте для пилотных сценариев и ограниченных rollout-потоков."
msgstr "Enable for pilot scenarios and limited rollout flows."

#: .\src\django_consent_152fz\admin.py:374
msgid "Отключите цель, чтобы исключить её из активных потоков согласия."
msgstr "Mute a target to remove it from active consent threads."

#: .\src\django_consent_152fz\admin.py:405
msgid "Выберите тип документа. В БД сохраняется технический код."
msgstr "Select a document type. The technical code is stored in the database."

#: .\src\django_consent_152fz\admin.py:414
#: .\src\django_consent_152fz\admin.py:787
#: .\src\django_consent_152fz\admin.py:871
msgid "Тип документа"
msgstr "Document type"

#: .\src\django_consent_152fz\admin.py:416
msgid "Активен"
msgstr "Active"

#: .\src\django_consent_152fz\admin.py:419
msgid "Уникальный код документа для ссылок из policy и access rules."
msgstr "Unique document code for links from policy and access rules."

#: .\src\django_consent_152fz\admin.py:420
msgid "Человекочитаемое название документа."
msgstr "Human-readable title of the document."

#: .\src\django_consent_152fz\admin.py:421
msgid "Тип документа для группировки и фильтрации редакций."
msgstr "Document type for grouping and filtering revisions."

#: .\src\django_consent_152fz\admin.py:422
msgid "Описание области применения и юридического назначения документа."
msgstr "Description of the scope and legal purpose of the document."

#: .\src\django_consent_152fz\admin.py:423
msgid "Снимите флаг, чтобы скрыть документ из рабочих сценариев."
msgstr "Clear the checkbox to hide the document from working scripts."

