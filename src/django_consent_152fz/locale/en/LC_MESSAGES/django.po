msgstr "The document to which this edition refers."

#: .\src\django_consent_152fz\admin.py:494
msgid "Код цели, с которой связана публикация редакции."
msgstr "Code of the purpose with which the editorial publication is associated."

#: .\src\django_consent_152fz\admin.py:495
msgid "Версия редакции в versioned-flow документа."
msgstr "The revision version in the document's versioned-flow."

#: .\src\django_consent_152fz\admin.py:497
msgid ""
"Формат содержимого: text/markdown/html или file-формат (PDF/DOC/DOCX/ODT/"
"ODTX). Для новых шаблонов рекомендуем markdown."
msgstr "Content format: text/markdown/html or file format (PDF/DOC/DOCX/ODT/ODTX). For new templates, we recommend markdown."

#: .\src\django_consent_152fz\admin.py:500
msgid "Текст редакции, если выбран текстовый формат."
msgstr "Revision text, if text format is selected."

#: .\src\django_consent_152fz\admin.py:502
msgid ""
"Загрузите файл редакции для сценариев с файлами (PDF, DOC, DOCX, ODT, ODTX)."
msgstr "Upload the revision file for scripts with files (PDF, DOC, DOCX, ODT, ODTX)."

#: .\src\django_consent_152fz\admin.py:505
msgid "JSON-снимок бизнес-полей на момент публикации."
msgstr "JSON snapshot of business fields at the time of publication."

#: .\src\django_consent_152fz\admin.py:506
msgid "Дополнительные служебные метаданные в формате JSON."
msgstr "Additional service metadata in JSON format."

#: .\src\django_consent_152fz\admin.py:507
msgid "Активная редакция используется в текущем потоке согласия."
msgstr "The active edition is used in the current consent flow."

#: .\src\django_consent_152fz\admin.py:508
msgid "Отметка коробочного шаблона, поставляемого пакетом."
msgstr "Marking the box template supplied in the package."

#: .\src\django_consent_152fz\admin.py:509
msgid "Дата и время публикации редакции."
msgstr "Date and time of publication of the editorial."

#: .\src\django_consent_152fz\admin.py:510
#: .\src\django_consent_152fz\verified_consents\admin.py:280
msgid "Техническое время создания записи."
msgstr "Technical time of record creation."

#: .\src\django_consent_152fz\admin.py:519
#: .\src\django_consent_152fz\admin.py:560
#: .\src\django_consent_152fz\templates\django_consent_152fz\subject_consents.html:81
#: .\src\django_consent_152fz\verified_consents\admin.py:196
#: .\src\django_consent_152fz\verified_consents\admin.py:303
#: .\src\django_consent_152fz\verified_consents\admin.py:343
msgid "Цель"
msgstr "Target"

#: .\src\django_consent_152fz\admin.py:521
#: .\src\django_consent_152fz\admin.py:629
msgid "Охват"
msgstr "Coverage"

#: .\src\django_consent_152fz\admin.py:522
msgid "Django-группа"
msgstr "Django group"

#: .\src\django_consent_152fz\admin.py:523
msgid "Требуется согласие"
msgstr "Consent required"

#: .\src\django_consent_152fz\admin.py:524
#: .\src\django_consent_152fz\admin.py:639
msgid "Активно"
msgstr "Actively"

#: .\src\django_consent_152fz\admin.py:525
#: .\src\django_consent_152fz\admin.py:569
#: .\src\django_consent_152fz\verified_consents\admin.py:211
msgid "Начало действия"
msgstr "Start of action"

#: .\src\django_consent_152fz\admin.py:526
#: .\src\django_consent_152fz\admin.py:570
#: .\src\django_consent_152fz\verified_consents\admin.py:212
msgid "Окончание действия"
msgstr "End of action"

#: .\src\django_consent_152fz\admin.py:527
#: .\src\django_consent_152fz\admin.py:571
#: .\src\django_consent_152fz\verified_consents\admin.py:213
#: .\src\django_consent_152fz\verified_consents\admin.py:311
#: .\src\django_consent_152fz\verified_consents\admin.py:355
msgid "Заметки"
msgstr "Notes"

#: .\src\django_consent_152fz\admin.py:528
msgid "Создано пользователем"
msgstr "Created by user"

#: .\src\django_consent_152fz\admin.py:531
msgid "Цель согласия, на которую действует правило аудитории."
msgstr "The target of consent that is affected by the audience rule."

#: .\src\django_consent_152fz\admin.py:532
msgid "Документ/редакция, требуемые для доступа аудитории."
msgstr "Document/edition required for audience access."

#: .\src\django_consent_152fz\admin.py:533
msgid "Режим охвата: глобально или только для конкретной группы."
msgstr "Coverage mode: global or only for a specific group."

#: .\src\django_consent_152fz\admin.py:534
msgid "Django-группа, если правило ограничено group-режимом."
msgstr "Django group, if the rule is limited to group mode."

#: .\src\django_consent_152fz\admin.py:535
msgid "Требовать ли согласие по правилу для целевой аудитории."
msgstr "Whether to require consent according to the target audience rule."

#: .\src\django_consent_152fz\admin.py:536
msgid "Отключите правило, чтобы временно исключить его из вычислений."
msgstr "Disable a rule to temporarily exclude it from calculations."

#: .\src\django_consent_152fz\admin.py:537
msgid "Начало действия правила (опционально)."
msgstr "Start of the rule (optional)."

#: .\src\django_consent_152fz\admin.py:538
msgid "Окончание действия правила (опционально)."
msgstr "End of the rule (optional)."

#: .\src\django_consent_152fz\admin.py:539
msgid "Внутренние комментарии для сопровождения правила."
msgstr "Internal comments to accompany the rule."

#: .\src\django_consent_152fz\admin.py:540
msgid "Пользователь, создавший правило."
msgstr "The user who created the rule."

#: .\src\django_consent_152fz\admin.py:562
msgid "Код ресурса"
msgstr "Resource code"

#: .\src\django_consent_152fz\admin.py:563
msgid "Метка приложения"
msgstr "Application Label"

#: .\src\django_consent_152fz\admin.py:564
msgid "Модель"
msgstr "Model"

#: .\src\django_consent_152fz\admin.py:565
#: .\src\django_consent_152fz\templates\django_consent_152fz\subject_consents.html:87
msgid "Действие"
msgstr "Action"

#: .\src\django_consent_152fz\admin.py:566
msgid "При отсутствии согласия"
msgstr "In the absence of consent"

#: .\src\django_consent_152fz\admin.py:567
msgid "При устаревшем согласии"
msgstr "With legacy consent"

#: .\src\django_consent_152fz\admin.py:572
#: .\src\django_consent_152fz\verified_consents\admin.py:214
#: .\src\django_consent_152fz\verified_consents\admin.py:312
#: .\src\django_consent_152fz\verified_consents\admin.py:356
msgid "Доп. метаданные"
msgstr "Add. metadata"

#: .\src\django_consent_152fz\admin.py:576
msgid ""
"Стабильный уникальный код политики доступа (например: `public_profile_view`, "
"`orders_export`, `crm_contact_update`). Нужен не только для API-интеграций: "
"используется в аудит-логах, внутренних ссылках и для однозначной "
"идентификации policy в guard layer."
msgstr "Stable unique access policy code (for example: __M0__, __M1__, __M2__). It is needed not only for API integrations: it is used in audit logs, internal links and for unique identification of policy in the guard layer."

#: .\src\django_consent_152fz\admin.py:581
msgid "Краткое название политики доступа."
msgstr "Short name of the access policy."

#: .\src\django_consent_152fz\admin.py:582
msgid "Опишите, какой ресурс и почему ограничивается согласием."
msgstr "Describe which resource is limited by consent and why."

#: .\src\django_consent_152fz\admin.py:583
msgid "Цель согласия, проверяемая перед доступом."
msgstr "Purpose of consent verified before access."

#: .\src\django_consent_152fz\admin.py:585
msgid ""
"Документ/редакция, подтверждающие требуемое согласие. В списке отображается "
"формат «Название (код)»."
msgstr "Document/edition confirming the required consent. The list displays the format “Name (code)”."

#: .\src\django_consent_152fz\admin.py:589
msgid ""
"Стабильный код защищаемого ресурса или бизнес-операции (например: "
"`profile_page`, `orders_export_csv`, `support_ticket_update`, "
"`billing.invoice_export`). Ресурсом считается страница, действие или "
"endpoint, доступ к которым проверяется policy/guard layer. Для охвата по "
"подсистемам используйте модульный префикс (`crm.contact_update`, "
"`billing.invoice_export`, `support.ticket_view`)."
msgstr "Stable code of the protected resource or business operation (for example: __M0__, __M1__, __M2__, __M3__). A resource is considered to be a page, action or endpoint, access to which is verified by the policy/guard layer. To cover by subsystem, use the modular prefix (__M4__, __M5__, __M6__)."

#: .\src\django_consent_152fz\admin.py:598
msgid "Django app_label целевой модели для model-level проверок."
msgstr "Django app_label of the target model for model-level checks."

#: .\src\django_consent_152fz\admin.py:599
msgid "Имя модели (без app_label) для model-level проверок."
