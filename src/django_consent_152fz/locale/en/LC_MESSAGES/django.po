#: .\src\django_consent_152fz\admin.py:484
msgid "Файл редакции"
msgstr "Revision file"

#: .\src\django_consent_152fz\admin.py:485
msgid "Снимок полей"
msgstr "Snapshot of the fields"

#: .\src\django_consent_152fz\admin.py:486
#: .\src\django_consent_152fz\verified_consents\admin.py:266
msgid "Метаданные"
msgstr "Metadata"

#: .\src\django_consent_152fz\admin.py:487
msgid "Опубликована"
msgstr "Published"

#: .\src\django_consent_152fz\admin.py:488
msgid "Коробочный шаблон"
msgstr "Box template"

#: .\src\django_consent_152fz\admin.py:489
msgid "Дата публикации"
msgstr "Publication date"

#: .\src\django_consent_152fz\admin.py:490
